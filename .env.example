# ---------------------------------------------------------------------------
# kumbuka.ai — environment template
# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# Public domain served by Caddy. Auto-TLS via Let's Encrypt requires this to
# resolve publicly. For purely local work, set this to `localhost` and Caddy
# will issue an internal cert (browser will warn).
KUMBUKA_DOMAIN=dev.kumbuka.ai

# Email used by Caddy for ACME / Let's Encrypt registration.
ACME_EMAIL=ops@example.com

# ---------------------------------------------------------------------------
# Postgres — one instance, two databases (created by postgres/init-db.sh)
# ---------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-superuser

# Per-database app users (created by the init script).
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me-keycloak-db
KEYCLOAK_DB_NAME=keycloak

KUMBUKA_DB_USER=kumbuka
KUMBUKA_DB_PASSWORD=change-me-kumbuka-db
KUMBUKA_DB_NAME=kumbuka

# ---------------------------------------------------------------------------
# Keycloak bootstrap admin (realm: master). Used only for first boot.
# ---------------------------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin

# Public-facing Keycloak hostname (separate Caddy vhost — Keycloak serves
# https://${KC_HOSTNAME}/realms/…). Must also resolve to Caddy from the host
# (e.g. /etc/hosts entry → 127.0.0.1) and from inside the docker network
# (handled automatically via the compose `aliases` on the caddy service).
KC_HOSTNAME=auth.dev.kumbuka.ai

# ---------------------------------------------------------------------------
# OIDC clients (realm: kumbuka)
#   - kumbuka-connector : confidential web client, PKCE S256 + client secret
#                         (see ADR-0006). Used by claude.ai / Claude Desktop.
#   - kumbuka-admin     : confidential web-app client (BFF, browser login)
#   - kumbuka-backend   : confidential service-account client (Admin REST API)
#
# Note: Keycloak realm imports do not interpolate env vars — the placeholder
# secrets here mirror the ones in keycloak/realm-import/kumbuka-realm.json.
# When you change a secret in .env you must also update the realm file (or
# rotate via the Admin REST API after first boot).
# ---------------------------------------------------------------------------
KUMBUKA_ADMIN_CLIENT_ID=kumbuka-admin
KUMBUKA_ADMIN_CLIENT_SECRET=change-me-kumbuka-admin-secret

KUMBUKA_BACKEND_CLIENT_ID=kumbuka-backend
KUMBUKA_BACKEND_CLIENT_SECRET=change-me-kumbuka-backend-secret

KUMBUKA_CONNECTOR_CLIENT_ID=kumbuka-connector
KUMBUKA_CONNECTOR_CLIENT_SECRET=change-me-kumbuka-connector-secret

# ---------------------------------------------------------------------------
# Backend session signing (HttpOnly cookie for admin BFF). 32+ bytes random.
#   Generate:  openssl rand -hex 32
# ---------------------------------------------------------------------------
BACKEND_SESSION_SECRET=change-me-32-bytes-of-random-hex

# ---------------------------------------------------------------------------
# Kumbuka app configuration (read by backend)
#   Note: writePolicy / defaultScope / createScopes are NOT here — they are
#   runtime settings stored in the team_settings table and editable via the
#   admin UI (handoff §D).
# ---------------------------------------------------------------------------
# memory_load_context: max entries returned per type.
KUMBUKA_LOAD_CONTEXT_PER_TYPE_LIMIT=20
