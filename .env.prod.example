# ---------------------------------------------------------------------------
# .env.prod.example — production deploy environment template.
# Copy to .env (NOT committed) and fill in real values. Used together with
# docker-compose.prod.yml and deploy/caddy/kumbuka.caddy.
# ---------------------------------------------------------------------------

# Version of the GHCR images to run. deploy.sh flips this and snapshots
# the previous value into KUMBUKA_PREVIOUS_VERSION so it can roll back.
KUMBUKA_VERSION=v0.1.0
KUMBUKA_PREVIOUS_VERSION=

# Keycloak image versioned independently of the server stack (D-OPS-29).
KEYCLOAK_VERSION=v0.6.6

# Name of the existing docker network the host Caddy is attached to.
# Find it with: `docker inspect <caddy-container> --format '{{json .NetworkSettings.Networks}}'`
CADDY_NETWORK=caddy_default

# Public hostnames Caddy serves.
KUMBUKA_DOMAIN=kumbuka.example.com
KC_HOSTNAME=auth.kumbuka.example.com

# Postgres superuser (only used by postgres/init-db.sh on first boot).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Per-database app users (created by init-db.sh).
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me
KEYCLOAK_DB_NAME=keycloak

KUMBUKA_DB_USER=kumbuka
KUMBUKA_DB_PASSWORD=change-me
KUMBUKA_DB_NAME=kumbuka

# Keycloak bootstrap admin (master realm — used to log into the Keycloak
# admin console for the first time, then create real admins).
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# OIDC client credentials. The realm import seeds these as-is; you
# rotate them by editing the realm import OR via the Keycloak Admin API
# after first boot.
KUMBUKA_ADMIN_CLIENT_ID=kumbuka-admin
KUMBUKA_ADMIN_CLIENT_SECRET=change-me-admin

KUMBUKA_BACKEND_CLIENT_ID=kumbuka-backend
KUMBUKA_BACKEND_CLIENT_SECRET=change-me-backend

KUMBUKA_CONNECTOR_CLIENT_ID=kumbuka-connector
KUMBUKA_CONNECTOR_CLIENT_SECRET=change-me-connector

# kumbuka-ops realm (D-OPS-27) client secrets + SMTP password, now rendered into
# the baked realm imports by the keycloak image entrypoint (D-OPS-29). Import is
# a no-op on the existing realms; a missing var only skips that no-op import.
KUMBUKA_OPS_CLIENT_SECRET=change-me-ops
KUMBUKA_OPS_ADMIN_CLIENT_SECRET=change-me-ops-admin
KC_SMTP_PASSWORD=change-me-smtp

# 32+ bytes of random hex for the BFF session signing key.
# Generate with: openssl rand -hex 32
BACKEND_SESSION_SECRET=change-me-32-bytes-of-random-hex

# Backend tuning.
KUMBUKA_LOAD_CONTEXT_PER_TYPE_LIMIT=20

# GHCR Personal Access Token used by deploy.sh for `docker login`.
# Read from a file, not committed here; set on the host at
# /etc/kumbuka/ghcr.pat (chmod 600).
GHCR_PAT_FILE=/etc/kumbuka/ghcr.pat
GHCR_USERNAME=jbaconsult
