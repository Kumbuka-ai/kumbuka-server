# ---------------------------------------------------------------------------
# kumbuka production deploy environment. Secrets generated via openssl rand.
# chmod 600. NOT committed anywhere. Consumed by compose.prod.yml + scripts.
# ---------------------------------------------------------------------------
KUMBUKA_VERSION=v0.1.0
KUMBUKA_PREVIOUS_VERSION=v0.1.0

# Keycloak image is versioned independently of the server stack since D-OPS-29
# (built + released from github.com/kumbuka-ai/kumbuka-keycloak).
KEYCLOAK_VERSION=v0.6.6

# Host Caddy's docker network (discovered).
CADDY_NETWORK=jba-stack_internal

# Three-host topology.
#   KUMBUKA_DOMAIN = public/MCP host -> drives backend public-base-url, so the
#                    OAuth protected-resource id is https://<KUMBUKA_DOMAIN>/mcp.
#   CONSOLE_DOMAIN = admin console UI host (UI + /api/* via BFF).
#   KC_HOSTNAME    = Keycloak host.
# CONSOLE_DOMAIN is consumed by the host Caddy snippet (set on the Caddy
# container env), not by compose.prod.yml.
KUMBUKA_DOMAIN=mcp.kumbuka.ai
CONSOLE_DOMAIN=console.kumbuka.ai
KC_HOSTNAME=auth.kumbuka.ai

# Postgres superuser (used by postgres/init-db.sh on first boot only).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_ME

KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=REPLACE_ME
KEYCLOAK_DB_NAME=keycloak

KUMBUKA_DB_USER=kumbuka
KUMBUKA_DB_PASSWORD=REPLACE_ME
KUMBUKA_DB_NAME=kumbuka

# Keycloak bootstrap admin (master realm).
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=REPLACE_ME

# OIDC client secrets. Consumed by both the backend AND the keycloak image's
# entrypoint, which renders them into the baked realm imports at boot. The realms
# already exist in the DB so import is a no-op; a missing secret only skips that
# realm's (no-op) import, never crashes Keycloak — but keep them set so a fresh
# bootstrap imports cleanly. Must match the live realm.
KUMBUKA_ADMIN_CLIENT_ID=kumbuka-admin
KUMBUKA_ADMIN_CLIENT_SECRET=REPLACE_ME

KUMBUKA_BACKEND_CLIENT_ID=kumbuka-backend
KUMBUKA_BACKEND_CLIENT_SECRET=REPLACE_ME

# Connector secret: also given to claude.ai when registering the MCP connector.
KUMBUKA_CONNECTOR_CLIENT_ID=kumbuka-connector
KUMBUKA_CONNECTOR_CLIENT_SECRET=REPLACE_ME

# kumbuka-ops realm (D-OPS-27 provider) client secrets — newly required by the
# baked realm import (the ops realm was previously unversioned). Retrieve the
# live values from the running realm before deploying, e.g.:
#   kcadm.sh get clients -r kumbuka-ops -q clientId=kumbuka-ops --fields secret
KUMBUKA_OPS_CLIENT_SECRET=REPLACE_ME
KUMBUKA_OPS_ADMIN_CLIENT_SECRET=REPLACE_ME

# SMTP app password for the kumbuka realm's transactional email.
KC_SMTP_PASSWORD=REPLACE_ME

# BFF session signing key.
BACKEND_SESSION_SECRET=REPLACE_ME

KUMBUKA_LOAD_CONTEXT_PER_TYPE_LIMIT=20

# GHCR auth for deploy.sh.
GHCR_PAT_FILE=/etc/kumbuka/ghcr.pat
GHCR_USERNAME=jbaconsult
