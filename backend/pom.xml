<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Reactor parent for the kumbuka backend.

        Two artifacts ship from here:
          - kumbuka-spi   — frozen interfaces consumed by the commercial
                            (multi-tenant) edition (ADR-0011). Pure Java,
                            no Quarkus, no JPA, no transitive runtime
                            surface. Published to GitHub Packages Maven.
          - kumbuka-server — the OSS Quarkus application. Depends on
                            kumbuka-spi for the SPI shape; ships
                            DefaultSingleTenantResolver as the default
                            implementation. ALSO published as a Maven
                            library to GitHub Packages from v0.4.0 onward
                            (D-OPS-23) so the commercial SaaS runtime
                            (ops-console/saas-runtime/) can consume it
                            and overlay its request-aware resolver bean
                            via Quarkus' @DefaultBean precedence.
    -->

    <groupId>ai.kumbuka</groupId>
    <artifactId>kumbuka-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>kumbuka-parent</name>
    <description>Reactor parent for kumbuka-spi + kumbuka-server.</description>
    <url>https://github.com/Kumbuka-ai/kumbuka-server</url>

    <licenses>
        <license>
            <name>AGPL-3.0-only</name>
            <url>https://www.gnu.org/licenses/agpl-3.0.txt</url>
        </license>
    </licenses>

    <scm>
        <connection>scm:git:https://github.com/Kumbuka-ai/kumbuka-server.git</connection>
        <developerConnection>scm:git:git@github.com:Kumbuka-ai/kumbuka-server.git</developerConnection>
        <url>https://github.com/Kumbuka-ai/kumbuka-server</url>
    </scm>

    <modules>
        <module>spi</module>
        <module>server</module>
    </modules>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <!--
        GitHub Packages Maven distribution. Authentication is provided
        by the GitHub Actions GITHUB_TOKEN at release time via a
        settings.xml the release workflow writes. Local `mvn deploy` is
        not expected and not configured (use the release workflow).
    -->
    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages — Kumbuka-ai/kumbuka-server</name>
            <url>https://maven.pkg.github.com/Kumbuka-ai/kumbuka-server</url>
        </repository>
        <snapshotRepository>
            <id>github</id>
            <name>GitHub Packages — Kumbuka-ai/kumbuka-server</name>
            <url>https://maven.pkg.github.com/Kumbuka-ai/kumbuka-server</url>
        </snapshotRepository>
    </distributionManagement>
</project>
